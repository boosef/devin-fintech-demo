# Copy to .env.local (gitignored) and fill in real values. Never commit .env.local.

# 32-byte AES-256-GCM key, base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
REFUNDS_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Dev-only mock auth from @acme/auth-guard. Must be exactly the lowercase string
# "true"; any other value (including "1" or "TRUE") disables mock auth.
MOCK_AUTH_ENABLED=true
