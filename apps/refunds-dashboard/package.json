{
  "name": "@acme/refunds-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=default --reporter=json --outputFile=test-results.json",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx --conditions=react-server --env-file=.env.local scripts/seed.ts"
  },
  "dependencies": {
    "@acme/audit-log": "workspace:*",
    "@acme/auth-guard": "workspace:*",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.18.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
