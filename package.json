{
  "name": "devin-fintech-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Shared platform layer for internal fintech tools",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "lint": "turbo run lint",
    "lint:root": "eslint --no-error-on-unmatched-pattern scripts team-apps *.mjs *.ts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:scripts": "vitest run --project scripts --reporter=default --reporter=json --outputFile=scripts/test-results.json",
    "test:ci": "turbo run test && node scripts/check-test-baselines.mjs",
    "create-team-app": "node scripts/create-team-app.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.6",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.36.0",
    "turbo": "2.11.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  }
}
